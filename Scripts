Installation automaisé de netdata
  bash scripts/setup.sh
#!/bin/bash

echo "[INFO] Updating system..."
sudo apt update -y

echo "[INFO] Installing Netdata..."
sudo apt install -y netdata

echo "[INFO] Deploying custom chart..."
sudo cp config/custom_cpu_usage.chart.sh /etc/netdata/charts.d/
sudo chmod +x /etc/netdata/charts.d/custom_cpu_usage.chart.sh

echo "[INFO] Deploying alert configuration..."
sudo cp config/cpu_usage.conf /etc/netdata/health.d/

echo "[INFO] Restarting Netdata..."
sudo systemctl restart netdata

echo "[INFO] Installation complete!"
echo "Dashboard available at: http://$(hostname -I | awk '{print $1}'):19999"



Test du monitoring
  bash scripts/test_dashboard.sh
#!/bin/bash

echo "[INFO] Installing stress-ng..."
sudo apt install -y stress-ng

echo "[INFO] Generating CPU load for 30 seconds..."
stress-ng --cpu 4 --timeout 30s

echo "[INFO] Load test completed. Check your Netdata dashboard."


Nettoyage et suppression
  bash scripts/cleanup.sh
#!/bin/bash

echo "[INFO] Stopping Netdata..."
sudo systemctl stop netdata

echo "[INFO] Removing Netdata..."
sudo apt remove --purge -y netdata
sudo apt autoremove -y

echo "[INFO] Removing configuration files..."
sudo rm -rf /etc/netdata
sudo rm -rf /var/lib/netdata

echo "[INFO] Cleanup completed."



